# Copy to .env and fill in before running docker compose:
#   cp .env.example .env
#
# .env is gitignored. Nothing in this file is a real credential — the values
# below are placeholders and the stack will not start until you replace them.

# --- Database ---
POSTGRES_DB=slangword
POSTGRES_USER=slangword
POSTGRES_PASSWORD=CHANGE_ME

# --- API ---
# Must be at least 32 characters; startup fails otherwise.
# Generate one:  openssl rand -base64 48
APP_JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING_OF_AT_LEAST_32_CHARS

# --- Ports ---
# Change if 8080 is already taken on your machine.
WEB_PORT=8080
