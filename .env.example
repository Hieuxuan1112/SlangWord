# Copy to .env and fill in every value below:
#
#   cp .env.example .env
#
# Values are left empty on purpose. A template that ships placeholder strings
# gets picked up by secret scanners and, worse, sometimes gets used as-is.
# The stack refuses to start while any of these is blank.

# --- Database ---
POSTGRES_DB=slangword
POSTGRES_USER=slangword

# Any value you like; it only ever protects the local container.
POSTGRES_PASSWORD=

# --- API ---
# At least 32 characters. Generate one with:
#   openssl rand -base64 48
APP_JWT_SECRET=

# --- Ports ---
# Change if 8080 is already taken on your machine.
WEB_PORT=8080
